{
  "info": {
    "_postman_id": "6a7f4889-f1e9-4a49-82f1-2f85c9367b5c",
    "name": "LedgerPay Phase 1",
    "description": "Reproducible Customer and Account CRUD workflow. Run the requests in collection order against a locally running LedgerPay application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Phase 1 workflow",
      "item": [
        {
          "name": "01 - Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"application is healthy\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "02 - Create customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const runId = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.unset(\"customerId\");",
                  "pm.collectionVariables.unset(\"accountId\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the Customer contract\", function () {",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.email).to.eql(`phase1.${pm.collectionVariables.get(\"runId\")}@example.com`);",
                  "    pm.expect(body.status).to.eql(\"ACTIVE\");",
                  "});",
                  "pm.collectionVariables.set(\"customerId\", String(body.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase1.{{runId}}@example.com\",\n  \"fullName\": \"Phase One Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/customers"
          }
        },
        {
          "name": "03 - Get customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns the created Customer\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"customerId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
          }
        },
        {
          "name": "04 - Update customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"updates the Customer\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.fullName).to.eql(\"Updated Phase One Customer\");",
                  "    pm.expect(body.status).to.eql(\"SUSPENDED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase1.{{runId}}@example.com\",\n  \"fullName\": \"Updated Phase One Customer\",\n  \"status\": \"SUSPENDED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
          }
        },
        {
          "name": "05 - List suspended customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns a paginated Customer list\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    pm.expect(body.page).to.eql(0);",
                  "    pm.expect(body.content.some(customer => String(customer.id) === pm.collectionVariables.get(\"customerId\"))).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/customers?page=0&size=20&status=SUSPENDED"
          }
        },
        {
          "name": "06 - Reject duplicate customer email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns the duplicate-email error contract\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"CUSTOMER_EMAIL_CONFLICT\");",
                  "    pm.expect(body.fieldErrors).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"PHASE1.{{runId}}@EXAMPLE.COM\",\n  \"fullName\": \"Duplicate Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/customers"
          }
        },
        {
          "name": "07 - Reject invalid customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns the validation error contract\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"VALIDATION_FAILED\");",
                  "    pm.expect(body.fieldErrors.some(error => error.field === \"email\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"fullName\": \"Invalid Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/customers"
          }
        },
        {
          "name": "08 - Create account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the Account contract\", function () {",
                  "    pm.expect(String(body.customerId)).to.eql(pm.collectionVariables.get(\"customerId\"));",
                  "    pm.expect(body.name).to.eql(\"Primary Wallet\");",
                  "    pm.expect(body.status).to.eql(\"ACTIVE\");",
                  "    pm.expect(body.currency).to.eql(\"MYR\");",
                  "});",
                  "pm.collectionVariables.set(\"accountId\", String(body.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"name\": \"Primary Wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/accounts"
          }
        },
        {
          "name": "09 - Get account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns the created Account\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"accountId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts/{{accountId}}"
          }
        },
        {
          "name": "10 - List active accounts for customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns a filtered Account page\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    pm.expect(body.content.some(account => String(account.id) === pm.collectionVariables.get(\"accountId\"))).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts?page=0&size=20&customerId={{customerId}}&status=ACTIVE"
          }
        },
        {
          "name": "11 - Reject duplicate account name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns the duplicate-name error contract\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"ACCOUNT_NAME_CONFLICT\");",
                  "    pm.expect(body.fieldErrors).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"name\": \"Primary Wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/accounts"
          }
        },
        {
          "name": "12 - Reject blank account name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns the validation error contract\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"VALIDATION_FAILED\");",
                  "    pm.expect(body.fieldErrors.some(error => error.field === \"name\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"name\": \" \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/accounts"
          }
        },
        {
          "name": "13 - Reject account for missing customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns the missing-Customer error contract\", function () {",
                  "    pm.response.to.have.status(404);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"CUSTOMER_NOT_FOUND\");",
                  "    pm.expect(body.fieldErrors).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 9223372036854775807,\n  \"name\": \"Missing Owner Wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/accounts"
          }
        },
        {
          "name": "14 - Update account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"updates the Account without adding a balance\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.name).to.eql(\"Reserve Wallet\");",
                  "    pm.expect(body.status).to.eql(\"SUSPENDED\");",
                  "    pm.expect(body.currency).to.eql(\"MYR\");",
                  "    pm.expect(body).not.to.have.property(\"balance\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Reserve Wallet\",\n  \"status\": \"SUSPENDED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/accounts/{{accountId}}"
          }
        },
        {
          "name": "15 - Reject deleting customer with account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"protects Account ownership\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"CUSTOMER_HAS_ACCOUNTS\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
          }
        },
        {
          "name": "16 - Delete account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"deletes the Account\", function () {",
                  "    pm.response.to.have.status(204);",
                  "    pm.expect(pm.response.text()).to.eql(\"\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts/{{accountId}}"
          }
        },
        {
          "name": "17 - Confirm account deletion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns Account not found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().code).to.eql(\"ACCOUNT_NOT_FOUND\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts/{{accountId}}"
          }
        },
        {
          "name": "18 - Delete customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"deletes the Customer after Account cleanup\", function () {",
                  "    pm.response.to.have.status(204);",
                  "    pm.expect(pm.response.text()).to.eql(\"\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
          }
        },
        {
          "name": "19 - Confirm customer deletion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns Customer not found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().code).to.eql(\"CUSTOMER_NOT_FOUND\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    }
  ]
}
